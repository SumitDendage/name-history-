# NameForge AI configuration. Copy to .env and edit. Real environment variables override this file.

# ---------- API server (Node.js + Express) ----------
PORT=8787
# Leave empty to run in demo mode (local sample generator, clearly labelled in the UI).
# The key is only read by the server and is never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Low keeps naming fast; raise it for more considered names.
ANTHROPIC_EFFORT=low
# auto = demo when no key is set | on = always demo | off = never demo (503 without a key)
DEMO_MODE=auto
DEMO_LATENCY_MS=1200
AI_TIMEOUT_MS=60000
RATE_LIMIT_PER_MINUTE=20
# Set to 1 (or true) when running behind one reverse proxy so rate limits see real client IPs.
TRUST_PROXY=
# Only needed if the React app is served from a different origin than the API.
CORS_ORIGIN=

# ---------- Optional Rust store (recent briefs) ----------
# Comment out STORE_URL to disable history entirely.
STORE_URL=http://127.0.0.1:8790
# Shared secret between the API server and the store. Use a long random string.
STORE_TOKEN=change-me-to-a-long-random-string

# Read by the store service itself
STORE_ADDR=127.0.0.1:8790
STORE_DB_PATH=data/nameforge.db
STORE_KEEP_PER_CLIENT=50
